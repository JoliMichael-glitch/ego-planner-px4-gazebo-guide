<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- ===== 光照 ===== -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===== 地面 ===== -->
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
              <torsional><ode/></torsional>
            </friction>
            <contact><ode/></contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>

    <!-- ===== 4面围墙 (20m x 20m 场地) ===== -->
    <model name="walls">
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- 北墙 -->
      <link name="wall_north">
        <collision name="wall_north_collision">
          <pose>0 10 1.25 0 0 0</pose>
          <geometry><box><size>20.15 0.15 2.5</size></box></geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact><ode/></contact>
            <bounce/>
            <friction><torsional><ode/></torsional><ode/></friction>
          </surface>
        </collision>
        <visual name="wall_north_visual">
          <pose>0 10 1.25 0 0 0</pose>
          <geometry><box><size>20.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
      </link>

      <!-- 东墙 -->
      <link name="wall_east">
        <collision name="wall_east_collision">
          <pose>10 0 1.25 0 0 1.5708</pose>
          <geometry><box><size>20.15 0.15 2.5</size></box></geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact><ode/></contact>
            <bounce/>
            <friction><torsional><ode/></torsional><ode/></friction>
          </surface>
        </collision>
        <visual name="wall_east_visual">
          <pose>10 0 1.25 0 0 1.5708</pose>
          <geometry><box><size>20.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
      </link>

      <!-- 南墙 -->
      <link name="wall_south">
        <collision name="wall_south_collision">
          <pose>0 -10 1.25 0 0 0</pose>
          <geometry><box><size>20.15 0.15 2.5</size></box></geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact><ode/></contact>
            <bounce/>
            <friction><torsional><ode/></torsional><ode/></friction>
          </surface>
        </collision>
        <visual name="wall_south_visual">
          <pose>0 -10 1.25 0 0 0</pose>
          <geometry><box><size>20.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
      </link>

      <!-- 西墙 -->
      <link name="wall_west">
        <collision name="wall_west_collision">
          <pose>-10 0 1.25 0 0 1.5708</pose>
          <geometry><box><size>20.15 0.15 2.5</size></box></geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact><ode/></contact>
            <bounce/>
            <friction><torsional><ode/></torsional><ode/></friction>
          </surface>
        </collision>
        <visual name="wall_west_visual">
          <pose>-10 0 1.25 0 0 1.5708</pose>
          <geometry><box><size>20.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
      </link>
    </model>

    <!-- ===== 障碍物 (圆柱体) ===== -->
    <model name="obstacle_0">
      <static>1</static>
      <pose>4.0 5.0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.145833</ixx><iyy>0.145833</iyy><izz>0.125</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.7 0.5 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <contact><ode><max_vel>0.01</max_vel><min_depth>0</min_depth></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <model name="obstacle_1">
      <static>1</static>
      <pose>-4.0 4.5 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.145833</ixx><iyy>0.145833</iyy><izz>0.125</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.7 0.5 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <contact><ode><max_vel>0.01</max_vel><min_depth>0</min_depth></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <model name="obstacle_2">
      <static>1</static>
      <pose>5.0 -4.0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.145833</ixx><iyy>0.145833</iyy><izz>0.125</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.7 0.5 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <contact><ode><max_vel>0.01</max_vel><min_depth>0</min_depth></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <model name="obstacle_3">
      <static>1</static>
      <pose>-5.0 -4.5 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.145833</ixx><iyy>0.145833</iyy><izz>0.125</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.7 0.5 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>1</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <contact><ode><max_vel>0.01</max_vel><min_depth>0</min_depth></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <model name="obstacle_4">
      <static>1</static>
      <pose>0.0 6.5 1.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.145833</ixx><iyy>0.145833</iyy><izz>0.125</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.5 0.6 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <contact><ode><max_vel>0.01</max_vel><min_depth>0</min_depth></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <model name="obstacle_5">
      <static>1</static>
      <pose>-3.0 -7.0 1.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.145833</ixx><iyy>0.145833</iyy><izz>0.125</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.5 0.6 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <contact><ode><max_vel>0.01</max_vel><min_depth>0</min_depth></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ===== 物理引擎 ===== -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- ===== 场景 ===== -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ===== GPS 坐标 ===== -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ===== 无人机: X500 ===== -->
    <model name="x500_0">
      <pose>0 0 2 0 0 0</pose>
      <include>
        <uri>model://x500</uri>
      </include>
    </model>

    <!-- ===== 摄像机初始视角 ===== -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-15 -10 10 0 0.6 2.2</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
